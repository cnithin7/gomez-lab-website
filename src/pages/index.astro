---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const publications = (await getCollection("publications")).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = publications.slice(0, 3);
const people = (await getCollection("people")).sort((a,b) => a.data.order - b.data.order).slice(0, 5);
const updates = (await getCollection("updates")).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout
  title="Gomez Lab | Cancer Genomics at WashU Medicine"
  description="The Gomez Lab at Washington University School of Medicine uses computational genomics to study lymphoma, multiple myeloma, and cancer disparities."
>
  <section class="home-intro">
    <div class="home-intro-copy">
      <p class="lab-kicker">
        Gomez Lab · Washington University School of Medicine
      </p>

      <h1>We study cancer through genomics and computation.</h1>

      <p class="home-lede">
        Our small research group develops and applies computational approaches
        to understand cancer biology, with particular interests in lymphoma,
        multiple myeloma, and representation in cancer genomics.
      </p>

      <p class="home-welcome">
        We are based in St. Louis and work closely with collaborators across
        WashU Medicine and the Siteman Cancer Center.
      </p>

      <div class="text-links">
        <a href="/research">Our research →</a>
        <a href="/team">Meet the lab →</a>
      </div>
    </div>
  </section>
