---
import "../styles/global.css";
const { title = "Gomez Lab", description = "Computational cancer genomics at Washington University School of Medicine.", image = "/images/share.jpg" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ["Research", "/research"],
  ["Projects", "/projects"],
  ["Team", "/team"],
  ["Gallery", "/gallery"],
  ["Tutorials", "/tutorial"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1e3a5f" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"ResearchOrganization","name":"Gomez Lab","url":"https://feliciagomezlab.org","parentOrganization":{"@type":"CollegeOrUniversity","name":"Washington University in St. Louis"},"email":"fgomez@wustl.edu"})}></script>
  </head>
  <body>
    <header class="site-header-shell">
      <div class="site-header">
        <a class="brand" href="/" aria-label="Gomez Lab home">
          <img src="/images/logo.png" alt="Gomez Lab" />
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {nav.map(([label, href]) => (
            <a class={path.startsWith(href) ? "active" : ""} href={href}>{label}</a>
          ))}
          <a class={path.startsWith('/contact') ? 'active' : ''} href="/contact">Contact</a>
        </nav>

        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            {nav.map(([label, href]) => (
              <a class={path.startsWith(href) ? "active" : ""} href={href}>{label}</a>
            ))}
            <a class={path.startsWith('/contact') ? 'active' : ''} href="/contact">Contact</a>
          </nav>
        </details>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="footer-brand">
        <img src="/images/logo.png" alt="Gomez Lab" />
        <p>A small computational cancer genomics lab at WashU Medicine.</p>
      </div>
      <div class="footer-contact">
        <a href="mailto:fgomez@wustl.edu">fgomez@wustl.edu</a>
        <p>Washington University School of Medicine · St. Louis, Missouri</p>
      </div>
    </footer>
    <script
      async
      src="https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js">
    </script>
  </body>
</html>
